{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulse-seat.example.com/schemas/reservation-expired.schema.json",
  "title": "Reservation Expired Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["reservation_id", "performance_id", "expired_at", "released_items"],
  "properties": {
    "reservation_id": { "type": "string" },
    "performance_id": { "type": "string" },
    "expired_at": { "type": "string", "format": "date-time" },
    "released_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "tier_id", "quantity"],
        "properties": {
          "type": { "enum": ["RESERVED_SEAT", "GENERAL_ADMISSION"] },
          "seat_id": { "type": "string" },
          "tier_id": { "type": "string" },
          "section_id": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
