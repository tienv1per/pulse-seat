{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulse-seat.example.com/schemas/booking-confirmed.schema.json",
  "title": "Booking Confirmed Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["booking_id", "reservation_id", "buyer_ref", "confirmed_at", "total_amount", "currency"],
  "properties": {
    "booking_id": { "type": "string" },
    "reservation_id": { "type": "string" },
    "buyer_ref": { "type": "string" },
    "confirmed_at": { "type": "string", "format": "date-time" },
    "total_amount": { "type": "integer", "minimum": 0 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
  }
}
