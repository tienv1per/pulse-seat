{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulse-seat.example.com/schemas/ticket-issued.schema.json",
  "title": "Ticket Issued Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["ticket_id", "booking_id", "event_id", "performance_id", "attendee_ref", "qr_token_hash", "issued_at"],
  "properties": {
    "ticket_id": { "type": "string" },
    "booking_id": { "type": "string" },
    "event_id": { "type": "string" },
    "performance_id": { "type": "string" },
    "seat_label": { "type": "string" },
    "attendee_ref": { "type": "string" },
    "qr_token_hash": { "type": "string" },
    "issued_at": { "type": "string", "format": "date-time" }
  }
}
