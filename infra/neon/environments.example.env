# Dev branch
NEON_DEV_BRANCH=pulse-seat-dev
NEON_DEV_PROJECT_ID=replace-me

# Staging branch/project
NEON_STAGING_BRANCH=pulse-seat-staging
NEON_STAGING_PROJECT_ID=replace-me

# Production branch/project
NEON_PRODUCTION_BRANCH=pulse-seat-prod
NEON_PRODUCTION_PROJECT_ID=replace-me

# Runtime services receive only their own pooled URL.
BOOKING_DATABASE_URL_POOLED=postgresql://booking_app:change-me@ep-dev-pooler.example.neon.tech/pulse_booking?sslmode=require

# Migration/admin jobs receive direct URLs separately.
BOOKING_DATABASE_URL_DIRECT=postgresql://booking_migrator:change-me@ep-dev.example.neon.tech/pulse_booking?sslmode=require
