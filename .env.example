# Pulse Seat local/dev configuration.
# Copy to .env for local runs. Do not commit real secrets.

SERVICE_NAME=booking
ENVIRONMENT=local
GRPC_ADDR=:9090

# HTTP_ADDR overrides every service when running one process manually.
# Prefer service-specific addresses when running multiple services.
API_GATEWAY_HTTP_ADDR=:8080
IDENTITY_HTTP_ADDR=:8081
SEARCH_HTTP_ADDR=:8082
BOOKING_HTTP_ADDR=:8083
PAYMENT_HTTP_ADDR=:8084
TICKET_HTTP_ADDR=:8085
NOTIFICATION_HTTP_ADDR=:8086

# Set to true in staging/prod service environments to require both Neon URLs.
PULSE_SEAT_REQUIRE_NEON=false

# Neon pooled URLs are for normal application traffic.
# Neon direct URLs are for migrations, admin tasks, backup/restore and CDC-like jobs.
IDENTITY_DATABASE_URL_POOLED=postgresql://identity_app:change-me@ep-dev-pooler.example.neon.tech/pulse_identity?sslmode=require
IDENTITY_DATABASE_URL_DIRECT=postgresql://identity_migrator:change-me@ep-dev.example.neon.tech/pulse_identity?sslmode=require
BOOKING_DATABASE_URL_POOLED=postgresql://booking_app:change-me@ep-dev-pooler.example.neon.tech/pulse_booking?sslmode=require
BOOKING_DATABASE_URL_DIRECT=postgresql://booking_migrator:change-me@ep-dev.example.neon.tech/pulse_booking?sslmode=require
PAYMENT_DATABASE_URL_POOLED=postgresql://payment_app:change-me@ep-dev-pooler.example.neon.tech/pulse_payment?sslmode=require
PAYMENT_DATABASE_URL_DIRECT=postgresql://payment_migrator:change-me@ep-dev.example.neon.tech/pulse_payment?sslmode=require
TICKET_DATABASE_URL_POOLED=postgresql://ticket_app:change-me@ep-dev-pooler.example.neon.tech/pulse_ticket?sslmode=require
TICKET_DATABASE_URL_DIRECT=postgresql://ticket_migrator:change-me@ep-dev.example.neon.tech/pulse_ticket?sslmode=require
NOTIFICATION_DATABASE_URL_POOLED=postgresql://notification_app:change-me@ep-dev-pooler.example.neon.tech/pulse_notification?sslmode=require
NOTIFICATION_DATABASE_URL_DIRECT=postgresql://notification_migrator:change-me@ep-dev.example.neon.tech/pulse_notification?sslmode=require

REDIS_URL=redis://localhost:6379/0
SEARCH_URL=http://localhost:9200
EVENT_BUS_BROKERS=localhost:9092
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=pulse-seat-local
